{
  "name": "v4-test-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Artifact, visual and functional test automation for APIMatic v4 generated portals",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24.14.0"
  },
  "type": "module",
  "scripts": {
    "portal:generate": "node scripts/serve-portal.mts --generate-only",
    "portal:serve": "node scripts/serve-portal.mts",
    "test": "playwright test",
    "test:artifacts": "playwright test --project=artifacts",
    "test:artifacts:update": "playwright test --project=artifacts --update-snapshots",
    "test:sdk-docs": "playwright test --project=artifacts tests/artifacts/petstore/sdk-docs.test.ts",
    "test:sdk-docs:update": "playwright test --project=artifacts tests/artifacts/petstore/sdk-docs.test.ts --update-snapshots",
    "test:code-samples": "playwright test --project=artifacts tests/artifacts/codegen",
    "test:code-samples:update": "playwright test --project=artifacts tests/artifacts/codegen --update-snapshots",
    "test:portal-artifacts-api": "playwright test --project=artifacts tests/artifacts/petstore/sdk-docs.test.ts tests/artifacts/codegen",
    "test:visual": "playwright test --project=visual",
    "test:visual:headed": "playwright test --project=visual --headed",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:functional": "playwright test --project=functional",
    "report": "playwright show-report",
    "types:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "adm-zip": "^0.6.1",
    "basic-auth": "^2.0.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^4.22.3",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
