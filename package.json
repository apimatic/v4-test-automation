{
  "name": "dxv2-test-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Visual and functional test automation for the apimatic-dx-portal-v2 docs portal",
  "type": "module",
  "scripts": {
    "setup:portal": "node scripts/setup-portal.mts",
    "generate-docs": "node scripts/serve-portal.mts --generate-only",
    "dev": "node scripts/serve-portal.mts --no-generate",
    "portal:generate": "node scripts/serve-portal.mts --generate-only",
    "portal:serve": "node scripts/serve-portal.mts",
    "test": "playwright test",
    "test:visual": "playwright test --project=dxv2-visual",
    "test:visual:headed": "playwright test --project=dxv2-visual --headed",
    "test:visual:update": "playwright test --project=dxv2-visual --update-snapshots",
    "test:functional": "playwright test --project=dxv2-functional",
    "report": "playwright show-report",
    "types:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "dotenv": "^17.2.4",
    "typescript": "^7.0.2"
  }
}
