            "text3": {
              "fontFamily": "Inter",
              "fontSize": "11.85px",
              "fontWeight": "400",
              "fontStyle": "normal",
              "lineHeight": "1.75"
            }
          },
          "code": {
            "fontFamily": "Courier Prime, monospace",
