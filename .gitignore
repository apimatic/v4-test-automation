node_modules/

# Local config — paths and secrets stay on your machine
.env

# Playwright output
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Generated portal output — `apimatic portal generate` writes it, and it is
# rebuilt from test-builds/<name>/src on every run. Never commit it.
test-builds/*/portal/


# Scratch probe scripts used while verifying locators
probe.tmp.*
.claude/
